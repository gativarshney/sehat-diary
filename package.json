{
  "name": "sehat-diary",
  "private": true,
  "version": "0.1.0",
  "description": "Hinglish voice record-keeper for home health readings that confirms what it is unsure about. Built on Gnani Prisma and Timbre.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:bench",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "emin": "tsx bench/emin/run-emin.ts",
    "test:bench": "vitest run --root bench",
    "tier-a": "tsx bench/tier-a/run-tier-a.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "tier-a:prepare": "tsx bench/tier-a/prepare.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4",
    "yaml": "^2.6.1",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
