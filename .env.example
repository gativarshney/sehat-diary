# Copy to .env (never commit .env)
GNANI_API_KEY=replace-me
# mock = no network calls (default); live = real calls, gated by GNANI_MAX_CREDITS
GNANI_MODE=mock
# hard cap on estimated credits this process may spend in live mode
GNANI_MAX_CREDITS=2
# derived from the dashboard headline on 2026-10-14 (5,000 credits = ~11,100 STT minutes, ~1,850,000 TTS chars)
GNANI_CREDITS_PER_STT_SECOND=0.0075
GNANI_CREDITS_PER_TTS_CHAR=0.0027

# public URL protections
SEHAT_LIVE_PER_IP_PER_HOUR=20
SEHAT_CORS_ORIGINS=http://localhost:5173
